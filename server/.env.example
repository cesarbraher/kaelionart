# Configuración del servidor KAELION Portal y Panel del Taller
# Copia este archivo a server/.env (nunca subas .env a Git).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Origen HTTPS público (sin barra final). Se usa para retornos de Stripe y enlaces de correo.
APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Base de datos MySQL (en producción siempre usa mysql; memory solo se permite en desarrollo/pruebas)
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Para bases remotas usa MYSQL_TLS=on y, si aplica, la ruta privada del certificado CA.
MYSQL_TLS=off
MYSQL_CA_FILE=

# Stripe (usa un sandbox dedicado en staging y claves live solo en producción)
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# SMTP (correo transaccional del portal)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KAELION Digital Art <info@kaelion.art>
SMTP_REPLY_TO=info@kaelion.art

# Seguridad y sesiones (genera un secreto aleatorio de >= 64 caracteres hexadecimales)
SESSION_SECRET=cambia-este-secreto-por-64-bytes-aleatorios-en-staging-y-produccion
SESSION_TTL_HOURS=24
DOWNLOAD_LINK_TTL_SECONDS=120

# Almacenamiento privado FUERA de la carpeta pública/webroot
PRIVATE_STORAGE_PATH=../private_storage
UPLOAD_MAX_BYTES=10485760
ORDER_REFERENCE_QUOTA_BYTES=41943040

# Zona horaria de visualización (las fechas en BD siempre se guardan en UTC)
TIMEZONE_DISPLAY=America/Mexico_City

# Solo para el script inicial: npm run seed:admin
ADMIN_EMAIL=taller@kaelion.art
ADMIN_NAME=Taller KAELION
ADMIN_PASSWORD=
ADMIN_ENABLE_MFA=false
